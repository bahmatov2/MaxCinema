@model MaxCinema.Models.Hall

@{
    ViewData["Title"] = "Добави нова зала";
}

<h1>Добави нова зала</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Name" class="control-label">Име на зала</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="TotalRows" class="control-label">Брой редове</label>
                        <input asp-for="TotalRows" class="form-control" type="number" min="1" value="8" />
                        <span asp-validation-for="TotalRows" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="SeatsPerRow" class="control-label">Места на ред</label>
                        <input asp-for="SeatsPerRow" class="form-control" type="number" min="1" value="10" />
                        <span asp-validation-for="SeatsPerRow" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-group mb-3">
                <div class="alert alert-info py-2">
                    <i class="fas fa-info-circle"></i>
                    <strong>Общо места:</strong> <span id="totalSeatsPreview">80</span>
                </div>
            </div>

            <div class="form-group">
                <input type="submit" value="Създай" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Назад</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function() {
            function updateTotalSeats() {
                var rows = parseInt($("#TotalRows").val()) || 0;
                var seats = parseInt($("#SeatsPerRow").val()) || 0;
                var total = rows * seats;
                $("#totalSeatsPreview").text(total);
            }

            $("#TotalRows, #SeatsPerRow").on("input", updateTotalSeats);
            updateTotalSeats();
        });
    </script>
}