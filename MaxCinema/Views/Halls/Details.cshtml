@model MaxCinema.Models.Hall

@{
    ViewData["Title"] = "Детайли за зала";
}

<h1>Детайли за зала</h1>

<div class="card">
    <div class="card-header">
        <h3>@Model.Name</h3>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Име на зала:</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Брой редове:</dt>
            <dd class="col-sm-9">@Model.TotalRows</dd>

            <dt class="col-sm-3">Места на ред:</dt>
            <dd class="col-sm-9">@Model.SeatsPerRow</dd>

            <dt class="col-sm-3">Общо места:</dt>
            <dd class="col-sm-9">@(Model.TotalRows* Model.SeatsPerRow)</dd>
        </dl>
    </div>
    <div class="card-footer">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Редактирай</a>
        <a asp-action="Index" class="btn btn-secondary">Назад</a>
    </div>
</div>