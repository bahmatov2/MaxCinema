@model IEnumerable<MaxCinema.Models.Hall>

@{
    ViewData["Title"] = "Зали";
}

<h1>Зали</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Добави нова зала</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Име на зала</th>
            <th>Брой редове</th>
            <th>Места на ред</th>
            <th>Общо места</th>
            <th>Активни прожекции</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.TotalRows</td>
                <td>@item.SeatsPerRow</td>
                <td>@(item.TotalRows* item.SeatsPerRow)</td>
                <td>
                    @{
                        var activeProjections = item.Projections?.Count(p => p.StartTime > DateTime.Now) ?? 0;
                    }
                    @if (activeProjections > 0)
                    {
                        <span class="badge bg-success">@activeProjections</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">0</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Редактирай</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Детайли</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Изтрий</a>
                </td>
            </tr>
        }
    </tbody>
</table>