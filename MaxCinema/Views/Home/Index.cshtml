@{
    ViewData["Title"] = "Начало";
}


<div class="hero-section text-white text-center py-5 mb-5" style="background: linear-gradient(135deg, #f15a24, #ff8c5a);">
    <h1 class="display-3">Добре дошли в MaxCinema,</h1>
    <p class="lead fs-3">Където филмите оживяват</p>
    <a asp-controller="Program" asp-action="Index" class="btn btn-light btn-lg px-5 py-3 mt-3">
        <i class="fas fa-calendar-alt me-2"></i>Виж програмата
    </a>
</div>


<div class="features py-5">
    <div class="container">
        <div class="row g-4">
            
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm text-center p-4">
                    <i class="fas fa-ticket-alt fa-4x text-warning mb-3"></i>
                    <h4 class="fw-bold">Лесен онлайн билет</h4>
                    <p class="text-muted">Изберете място и платете с няколко клика</p>
                </div>
            </div>

       
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm text-center p-4">
                    <i class="fas fa-couch fa-4x text-warning mb-3"></i>
                    <h4 class="fw-bold">Комфортни зали</h4>
                    <p class="text-muted">Широки седалки и съраунд звук</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm text-center p-4">
                    <i class="fas fa-mug-hot fa-4x text-warning mb-3"></i>
                    <h4 class="fw-bold">Първокласни пуканки</h4>
                    <p class="text-muted">Храни и напитки на бара</p>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="bg-light py-5 mt-auto">
    <div class="container text-center">
        <h2 class="mb-4">Готови ли сте за кино?</h2>
        <a asp-controller="Program" asp-action="Index" class="btn btn-success btn-lg px-5">
            <i class="fas fa-arrow-right me-2"></i>Към програмата
        </a>
    </div>
</div>