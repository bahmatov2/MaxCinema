@model MaxCinema.Models.Movie

@{
    ViewData["Title"] = "Изтриване на филм";
}

<h1>Изтриване на филм</h1>

<div class="alert alert-danger">
    <h3>Сигурни ли сте, че искате да изтриете този филм?</h3>
</div>

<div class="card">
    <div class="card-header">
        <h3>@Model.Title</h3>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Заглавие</dt>
            <dd class="col-sm-9">@Model.Title</dd>

            <dt class="col-sm-3">Жанр</dt>
            <dd class="col-sm-9">@Model.Genre</dd>

            <dt class="col-sm-3">Продължителност</dt>
            <dd class="col-sm-9">@Model.DurationMinutes минути</dd>
        </dl>
    </div>
    <div class="card-footer">
        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <input type="submit" value="Изтрий" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-secondary">Назад</a>
        </form>
    </div>
</div