@model IEnumerable<MaxCinema.Models.Projection>

@{
    ViewData["Title"] = "Програма";
}

<h1>Филмова програма</h1>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                @if (!string.IsNullOrEmpty(item.Movie?.ImageUrl))
                {
                    <img src="@item.Movie.ImageUrl" class="card-img-top" alt="@item.Movie.Title" style="height: 200px; object-fit: cover;">
                }
                else
                {
                    <div class="card-img-top bg-secondary text-white d-flex align-items-center justify-content-center" style="height: 200px;">
                        <i class="fas fa-film fa-3x"></i>
                    </div>
                }
                <div class="card-body">
                    <h5 class="card-title text-primary">@item.Movie?.Title</h5>
                    <p class="card-text">
                        <i class="fas fa-calendar-alt text-warning"></i>
                        <strong>Начало:</strong> @item.StartTime.ToString("dd.MM.yyyy HH:mm")<br />

                        <i class="fas fa-chair text-info"></i>
                        <strong>Зала:</strong> @item.Hall?.Name<br />

                        <i class="fas fa-ticket-alt text-success"></i>
                        <strong>Цена:</strong> @item.TicketPrice.ToString("F2") €
                    </p>
                </div>
                <div class="card-footer bg-white">
                    <div class="d-grid gap-2">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary">
                            <i class="fas fa-info-circle"></i> Детайли
                        </a>

                        @if (User.Identity.IsAuthenticated)
                        {
                            <a asp-controller="Tickets"
                               asp-action="Create"
                               asp-route-projectionId="@item.Id"
                               class="btn btn-success">
                                Купи билет
                            </a>
                        }
                        else
                        {
                            <a asp-area="Identity"
                               asp-page="/Account/Login"
                               class="btn btn-outline-primary">
                                <i class="fas fa-sign-in-alt"></i> Влезте, за да купите
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center">
        <i class="fas fa-info-circle fa-2x"></i>
        <h4>Няма предстоящи прожекции</h4>
        <p>Заповядайте отново по-късно!</p>
    </div>
}