@model MaxCinema.Models.Projection

@{
    ViewData["Title"] = "Изтриване на прожекция";
}

<h1>Изтриване на прожекция</h1>

<div class="alert alert-danger">
    <h4>Сигурни ли сте, че искате да изтриете тази прожекция?</h4>
</div>

<div class="card">
    <div class="card-header">
        <h5>@Model.Movie?.Title</h5>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Филм</dt>
            <dd class="col-sm-9">@Model.Movie?.Title</dd>

            <dt class="col-sm-3">Зала</dt>
            <dd class="col-sm-9">@Model.Hall?.Name</dd>

            <dt class="col-sm-3">Начало</dt>
            <dd class="col-sm-9">@Model.StartTime.ToString("dd.MM.yyyy HH:mm")</dd>

            <dt class="col-sm-3">Цена</dt>
            <dd class="col-sm-9">@Model.TicketPrice.ToString("F2") €</dd>
        </dl>

        <form asp-action="DeleteConfirmed" method="post">
            <input type="hidden" asp-for="Id" />
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger">Изтрий</button>
            <a asp-action="Index" class="btn btn-secondary ms-2">Назад</a>
        </form>
    </div>
</div>