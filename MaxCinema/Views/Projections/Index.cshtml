@model IEnumerable<MaxCinema.Models.Projection>

@{
    ViewData["Title"] = "Прожекции";
}

<h1>Прожекции</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Създай нова прожекция</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Филм</th>
            <th>Зала</th>
            <th>Начален час</th>
            <th>Цена</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Movie?.Title</td>
                <td>@item.Hall?.Name</td>
                <td>@item.StartTime.ToString("dd.MM.yyyy HH:mm")</td>
                <td>@item.TicketPrice.ToString("F2") €</td>  
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Редактирай</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Детайли</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Изтрий</a>
                </td>
            </tr>
        }
    </tbody>
</table>