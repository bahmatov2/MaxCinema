[Authorize]
public IActionResult Create(int? projectionId)
{
    // Диагностика
    Console.WriteLine("=== Create method started ===");
    Console.WriteLine($"ProjectionId received: {projectionId}");

    if (projectionId == null)
    {
        Console.WriteLine("ERROR: projectionId is null");
        return NotFound();
    }

    var projection = _context.Projections
        .Include(p => p.Movie)
        .Include(p => p.Hall)
        .Include(p => p.Tickets)
        .FirstOrDefault(p => p.Id == projectionId);

    if (projection == null)
    {
        Console.WriteLine($"ERROR: Projection with ID {projectionId} not found");
        return NotFound();
    }

    Console.WriteLine($"Projection found: {projection.Movie?.Title}, Hall: {projection.Hall?.Name}");

    // Проверка за бъдеща дата
    if (projection.StartTime <= DateTime.Now)
    {
        Console.WriteLine("ERROR: Projection is in the past");
        TempData["Error"] = "Не можете да купувате билети за минали прожекции.";
        return RedirectToAction("Index", "Program");
    }

    // Намираме свободните места
    var takenSeatIds = projection.Tickets.Select(t => t.SeatId).ToList();
    Console.WriteLine($"Taken seats: {takenSeatIds.Count}");

    var freeSeats = _context.Seats
        .Where(s => s.HallId == projection.HallId && !takenSeatIds.Contains(s.Id))
        .Select(s => new {
            Id = s.Id,
            DisplayName = $"Ред {s.Row}, Място {s.Number}"
        })
        .ToList();

    Console.WriteLine($"Free seats found: {freeSeats.Count}");

    if (!freeSeats.Any())
    {
        Console.WriteLine("ERROR: No free seats available");
        TempData["Error"] = "Няма свободни места за тази прожекция.";
        return RedirectToAction("Index", "Program");
    }

    ViewBag.Projection = projection;
    ViewBag.FreeSeats = new SelectList(freeSeats, "Id", "DisplayName");

    var ticket = new Ticket
    {
        ProjectionId = projection.Id,
        PricePaid = projection.TicketPrice,
        PurchasedAt = DateTime.Now
    };

    Console.WriteLine("=== Create method completed successfully ===");
    return View(ticket);
}