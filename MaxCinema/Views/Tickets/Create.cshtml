@model MaxCinema.Models.Ticket

@{
    ViewData["Title"] = "Купи билет";
    var projection = ViewBag.Projection as MaxCinema.Models.Projection;
}

<h1>Купи билет за @projection?.Movie?.Title</h1>

<div class="row">
    <div class="col-md-6">
        <!-- Информация за прожекцията -->
        <div class="card mb-3">
            <div class="card-header bg-primary text-white">
                <h4>Информация за прожекцията</h4>
            </div>
            <div class="card-body">
                <p><strong>🎬 Филм:</strong> @projection?.Movie?.Title</p>
                <p><strong>🏢 Зала:</strong> @projection?.Hall?.Name</p>
                <p><strong>📅 Начало:</strong> @projection?.StartTime.ToString("dd.MM.yyyy HH:mm")</p>
                <p><strong>💰 Цена:</strong> @projection?.TicketPrice.ToString("F2") €</p>
            </div>
        </div>

        <!-- Форма за избор на място -->
        <div class="card">
            <div class="card-header bg-success text-white">
                <h4>Избор на място</h4>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <input type="hidden" asp-for="ProjectionId" />
                    <input type="hidden" asp-for="PricePaid" />

                    <div class="form-group mb-3">
                        <label asp-for="SeatId" class="control-label">Избери място</label>
                        <select asp-for="SeatId" class="form-control" asp-items="ViewBag.FreeSeats">
                            <option value="">-- Изберете място --</option>
                        </select>
                    </div>

                    <button type="submit" class="btn btn-success">Купи билет</button>
                    <a asp-controller="Program" asp-action="Index" class="btn btn-secondary">Назад</a>
                </form>
            </div>
        </div>
    </div>
</div>