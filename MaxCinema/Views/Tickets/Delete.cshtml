@model MaxCinema.Models.Ticket

@{
    ViewData["Title"] = "Изтриване на билет";
}

<h1>Изтриване на билет</h1>

<h3>Сигурни ли сте, че искате да изтриете този билет?</h3>

<div class="card">
    <div class="card-header bg-danger text-white">
        <h4>Билет #@Model.Id</h4>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Филм:</dt>
            <dd class="col-sm-9">@Model.Projection?.Movie?.Title</dd>

            <dt class="col-sm-3">Зала:</dt>
            <dd class="col-sm-9">@Model.Projection?.Hall?.Name</dd>

            <dt class="col-sm-3">Начало:</dt>
            <dd class="col-sm-9">@Model.Projection?.StartTime.ToString("dd.MM.yyyy HH:mm")</dd>

            <dt class="col-sm-3">Място:</dt>
            <dd class="col-sm-9">Ред @Model.Seat?.Row, Място @Model.Seat?.Number</dd>

            <dt class="col-sm-3">Потребител:</dt>
            <dd class="col-sm-9">@Model.User?.Email</dd>

            <dt class="col-sm-3">Цена:</dt>
            <dd class="col-sm-9">@Model.PricePaid.ToString("F2") €</dd>

            <dt class="col-sm-3">Закупен на:</dt>
            <dd class="col-sm-9">@Model.PurchasedAt.ToString("dd.MM.yyyy HH:mm")</dd>
        </dl>
    </div>
    <div class="card-footer">
        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <input type="submit" value="Изтрий" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-secondary">Назад</a>
        </form>
    </div>
</div>