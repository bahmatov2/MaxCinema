@model MaxCinema.Models.Ticket

@{
    ViewData["Title"] = "Редактиране на билет";
}

<h1>Редактиране на билет</h1>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-warning">
                <h4>Билет #@Model.Id</h4>
            </div>
            <div class="card-body">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="form-group mb-3">
                        <label asp-for="ProjectionId" class="control-label">Прожекция</label>
                        <select asp-for="ProjectionId" class="form-control" asp-items="ViewBag.ProjectionId"></select>
                        <span asp-validation-for="ProjectionId" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="SeatId" class="control-label">Място</label>
                        <select asp-for="SeatId" class="form-control" asp-items="ViewBag.SeatId"></select>
                        <span asp-validation-for="SeatId" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="UserId" class="control-label">Потребител</label>
                        <select asp-for="UserId" class="form-control" asp-items="ViewBag.UserId"></select>
                        <span asp-validation-for="UserId" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="PricePaid" class="control-label">Цена</label>
                        <input asp-for="PricePaid" class="form-control" />
                        <span asp-validation-for="PricePaid" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="PurchasedAt" class="control-label">Закупен на</label>
                        <input asp-for="PurchasedAt" class="form-control" type="datetime-local" />
                        <span asp-validation-for="PurchasedAt" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <input type="submit" value="Запази" class="btn btn-primary" />
                        <a asp-action="Index" class="btn btn-secondary">Назад</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}