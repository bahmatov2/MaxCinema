@model IEnumerable<MaxCinema.Models.Ticket>

@{
    ViewData["Title"] = "Всички билети";
}

<h1>Всички билети</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Потребител</th>
            <th>Филм</th>
            <th>Зала</th>
            <th>Начало</th>
            <th>Ред</th>
            <th>Място</th>
            <th>Цена</th>
            <th>Закупен на</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.User?.Email</td>
                <td>@item.Projection?.Movie?.Title</td>
                <td>@item.Projection?.Hall?.Name</td>
                <td>@item.Projection?.StartTime.ToString("dd.MM.yyyy HH:mm")</td>
                <td>@item.Seat?.Row</td>
                <td>@item.Seat?.Number</td>
                <td>@item.PricePaid.ToString("F2") €</td>
                <td>@item.PurchasedAt.ToString("dd.MM.yyyy HH:mm")</td>
            </tr>
        }
    </tbody>
</table>